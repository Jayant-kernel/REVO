      {"id": "output_contracts", "points": 3, "metric": "incomplete_output_contracts", "max": 0}
    ]},
    {"id": "diversity", "weight": 15, "criteria": [
      {"id": "semantic_diversity", "points": 6, "metric": "undisposed_behavioral_duplicate_clusters", "max": 0},
