      {"id": "typed_callers", "points": 4, "metric": "untyped_production_callers", "max": 0},
      {"id": "contract_rules", "points": 8, "metric": "uncovered_or_violated_contract_rules", "max": 0}
    ]},
    {"id": "discrimination", "weight": 20, "criteria": [
      {"id": "challenge_suite", "points": 8, "metric": "challenge_deficient_contracts", "max": 0},
      {"id": "fixture_diversity", "points": 6, "metric": "contracts_with_fewer_than_four_distinct_fixtures", "max": 0},
      {"id": "relations", "points": 6, "metric": "contracts_with_fewer_than_two_discriminating_relations", "max": 0}
    ]},
    {"id": "instructions", "weight": 10, "criteria": [
      {"id": "public_rules", "points": 4, "metric": "missing_or_ambiguous_public_rules", "max": 0},
