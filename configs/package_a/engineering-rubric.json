    {"id": "pipeline", "weight": 10, "criteria": [
      {"id": "path_parity", "points": 4, "metric": "fake_real_evaluator_parity_failures", "max": 0},
      {"id": "recovery", "points": 3, "metric": "crash_retry_cap_or_accounting_failures", "max": 0},
      {"id": "protocol", "points": 3, "metric": "missing_protocol_or_prompt_receipts", "max": 0}
    ]},
    {"id": "reproducibility", "weight": 10, "criteria": [
      {"id": "dependency_manifests", "points": 4, "metric": "missing_dependency_manifests", "max": 0},
      {"id": "replay", "points": 3, "metric": "counterexample_or_qualification_replay_failures", "max": 0},
      {"id": "freshness", "points": 3, "metric": "stale_evidence_false_acceptances", "max": 0}
    ]},
    {"id": "isolation", "weight": 10, "criteria": [
      {"id": "rename_isolation", "points": 4, "metric": "rename_isolation_failures", "max": 0},
      {"id": "cross_product", "points": 3, "metric": "unresolved_cross_role_overlaps", "max": 0},
      {"id": "prompt_boundary", "points": 3, "metric": "prompt_boundary_failures", "max": 0}
    ]},
    {"id": "export", "weight": 5, "criteria": [
      {"id": "membership", "points": 2, "metric": "export_membership_or_empty_release_failures", "max": 0},
      {"id": "typed_roundtrip", "points": 2, "metric": "typed_loader_roundtrip_failures", "max": 0},
      {"id": "checksums", "points": 1, "metric": "checksum_completeness_failures", "max": 0}
