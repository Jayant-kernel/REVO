  "sql": "SELECT \n    student_id, \n    course_id, \n    grade, \n    recorded_at, \n    revision_id\nFROM (\n    SELECT \n        *,\n        ROW_NUMBER() OVER (\n            PARTITION BY student_id, course_id \n            ORDER BY \n                recorded_at DESC, \n                revision_id DESC\n        ) AS rn\n    FROM (\n        SELECT \n            *,\n            CASE WHEN revision_status = 'valid' THEN 1 ELSE 0 END AS is_valid\n        FROM grade_revisions\n    )\n    WHERE is_valid = 1\n) \nWHERE rn = 1\nORDER BY student_id, course_id",
