  "fixture_scope": "retained public base fixture",
  "instruction": "For completed playbacks in 2025, find the previous completed playback of the same title by the same viewer within that year. Order history by played_at then play_id; partial plays do not participate. Return play_id and previous_play_id ordered by play_id. The first playback in each history has NULL previous_play_id.",
  "schema": [{"columns":[{"name":"play_id","nullable":false,"type":"INTEGER"},{"name":"viewer_id","nullable":false,"type":"INTEGER"},{"name":"title_id","nullable":false,"type":"INTEGER"},{"name":"played_at","nullable":false,"type":"TIMESTAMP"},{"name":"status","nullable":false,"type":"VARCHAR"}],"name":"plays","row_count":10,"row_kind":"generic"}],
  "tables": {"plays": [
    {"play_id":7,"played_at":"2024-12-31 00:00:00","status":"completed","title_id":10,"viewer_id":1},
    {"play_id":4,"played_at":"2025-01-02 00:00:00","status":"completed","title_id":10,"viewer_id":2},
    {"play_id":2,"played_at":"2025-01-01 00:00:00","status":"completed","title_id":10,"viewer_id":1},
    {"play_id":3,"played_at":"2025-01-02 00:00:00","status":"completed","title_id":20,"viewer_id":1},
    {"play_id":1,"played_at":"2025-01-01 00:00:00","status":"completed","title_id":10,"viewer_id":1},
    {"play_id":5,"played_at":"2025-01-03 00:00:00","status":"partial","title_id":10,"viewer_id":1},
    {"play_id":6,"played_at":"2025-01-04 00:00:00","status":"completed","title_id":10,"viewer_id":1}
  ]},
  "sql": "SELECT play_id, previous_play_id\nFROM (\n  SELECT \n    p1.play_id,\n    LAG(p1.play_id, 1) OVER (PARTITION BY p1.viewer_id, p1.title_id ORDER BY p1.played_at, p1.play_id) AS previous_play_id\n  FROM plays p1\n  WHERE p1.status = 'completed'\n    AND EXTRACT(YEAR FROM p1.played_at) = 2025\n)\nORDER BY play_id",
